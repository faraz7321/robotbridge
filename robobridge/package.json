{
  "name": "robobridge",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun main.ts",
    "start:geprog": "bun --env-file .geprog.env main.ts",
    "start:lutz": "bun --env-file .lutz.env main.ts",
    "build:raw": "bun build main.ts --outfile robobridge-raw",
    "build": "bun build main.ts --compile --outfile robobridge",
    "build:linux": "bun run build && chmod +x robobridge",
    "build:windows": "bun run --env-file .lutz.env  build -- --target=bun-windows-x64",
    "test": "jest"
  },
  "devDependencies": {
    "@types/bun": "1.1.3",
    "@types/geojson": "7946.0.14",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "jest": "^29.7.0",
    "mocha": "^11.1.0",
    "ts-jest": "^29.2.5"
  }
}
